{
  "name": "student-portal-backend",
  "version": "1.0.0",
  "description": "Express backend for the Student Course Portal with PostgreSQL (Neon)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "build": "npm install && node db/setup.js",
    "start": "node server.js",
    "db:setup": "node db/setup.js",
    "db:seed": "node db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1"
  }
}
